<div class="min-h-screen w-full flex flex-col items-center justify-center p-4 bg-slate-900 relative overflow-hidden">
  
  <!-- 背景のほんのりした光のエフェクト -->
  <div class="absolute inset-0 bg-cover bg-center opacity-30 pointer-events-none"
       style="background-image: url('https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?q=80&w=1920&auto=format&fit=crop');">
  </div>

  <div class="relative z-10 w-full max-w-md bg-white p-8 sm:p-10 rounded-3xl shadow-2xl space-y-8 text-slate-900 border border-slate-200">
    <!-- ロゴ ＆ タイトル -->
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-600 text-white font-extrabold text-xl rounded-2xl shadow-md mb-2">
        
      </div>
      <h1 class="text-2xl font-bold text-slate-900">SoloBuddy にログイン</h1>
      <p class="text-sm text-slate-500">登録済みのメールアドレスとパスワードを入力してください。</p>
    </div>

    <!-- フォーム -->
    <%= form_with url: login_path, local: true, data: { turbo: false }, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.email_field :email, class: "w-full px-4 py-3.5 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition bg-slate-50 focus:bg-white" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.password_field :password, class: "w-full px-4 py-3.5 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition bg-slate-50 focus:bg-white" %>
      </div>

      <div class="pt-2">
        <%= f.submit "ログインする", class: "w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-base rounded-xl shadow-lg transition cursor-pointer active:scale-95" %>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-slate-200 text-center">
  <p class="text-xs text-slate-500 mb-2">アカウントをお持ちでない方はこちら</p>
  <%= link_to '新規会員登録（無料）', signup_path, class: 'text-blue-600 font-bold hover:underline text-sm' %>
</div>

    <!-- トップに戻るリンク -->
    <div class="text-center pt-2">
      <%= link_to root_path, data: { turbo: false }, class: "text-sm font-bold text-slate-500 hover:text-slate-800 transition" do %>
        ← トップページに戻る
      <% end %>
    </div>
  </div>
</div>