<!DOCTYPE html>
<html>
  <head>
    <title>通訳サポートアプリ - Interpreter Support App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex">

    <!-- 1. 左側サイドバー -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col shrink-0">
      <!-- ロゴ部分 -->
      <div class="p-6 border-b border-slate-100 flex items-center gap-3">
        <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center font-bold text-white text-sm">
          AS
        </div>
        <span class="font-bold text-slate-800 text-lg tracking-wide">Atogatari</span>
      </div>

      <!-- ナビゲーションメニュー -->
      <nav class="p-4 space-y-1 flex-1">
        <%= link_to root_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 hover:text-slate-900 transition" do %>
          <span>ホーム</span>
        <% end %>

        <%= link_to projects_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-700 bg-slate-100 rounded-lg transition" do %>
          <span>案件一覧</span>
        <% end %>
      </nav>

      <!-- ログアウト / アカウント情報 -->
      <% if logged_in? %>
        <div class="p-4 border-t border-slate-100">
          <div class="text-xs text-slate-500 mb-2 truncate"><%= current_user.email %></div>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 rounded-lg transition" %>
        </div>
      <% end %>
    </aside>

    <!-- 2. 右側メインコンテンツエリア -->
    <main class="flex-1 flex flex-col min-w-0">
      <!-- フラッシュメッセージ表示エリア -->
      <% flash.each do |message_type, message| %>
        <div class="p-4 m-6 mb-0 rounded-lg border text-sm <%= message_type == 'notice' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200' %>">
          <%= message %>
        </div>
      <% end %>

      <!-- 各ページのメインビューが入る場所 -->
      <div class="p-8">
        <%= yield %>
      </div>
    </main>

  </body>
</html>