<!DOCTYPE html>
<html>
  <head>
    <title>SoloBuddy - 通訳案件・収支管理</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col">

    <!-- 通知メッセージ -->
    <% flash.each do |message_type, message| %>
      <div class="p-4 m-4 rounded-xl border text-base font-bold shadow-sm <%= message_type == 'notice' ? 'bg-emerald-50 text-emerald-800 border-emerald-300' : 'bg-rose-50 text-rose-800 border-rose-300' %>">
        <%= message %>
      </div>
    <% end %>

    <% if current_page?(root_path) || current_page?(login_path) %>
      <!-- トップページまたはログイン画面のときはサイドバーなし -->
      <main class="flex-1 w-full min-h-screen flex flex-col">
        <%= yield %>
      </main>
    <% else %>
      <!-- ログイン後の画面（ダッシュボードや案件一覧等）のときはサイドバーを表示 -->
      <div class="flex flex-1 min-h-screen">
        <!-- 左側：サイドバー -->
        <aside class="w-72 bg-white text-slate-800 border-r border-slate-300 flex flex-col shrink-0 min-h-screen shadow-sm">
          <div class="p-6 border-b border-slate-200 flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center font-bold text-white text-lg shadow-sm">
              A
            </div>
            <div>
              <div class="font-bold text-slate-900 text-xl tracking-wide">SoloBuddy</div>
              <div class="text-xs text-slate-500 font-medium">通訳者向け案件管理</div>
            </div>
          </div>

          <nav class="p-4 space-y-2 flex-1">
            <%= link_to root_path, data: { turbo: false }, class: "flex items-center gap-3 px-4 py-3 text-base font-bold text-slate-700 rounded-xl hover:bg-slate-100 transition" do %>
              <span class="text-xl">🏠</span>
              <span>ホーム</span>
            <% end %>

            <% if logged_in? %>
              <%= link_to dashboard_path, data: { turbo: false }, class: "flex items-center gap-3 px-4 py-3 text-base font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded-xl shadow-sm transition" do %>
                <span class="text-xl">📊</span>
                <span>ダッシュボード</span>
              <% end %>

              <%= link_to projects_path, data: { turbo: false }, class: "flex items-center gap-3 px-4 py-3 text-base font-bold text-slate-700 rounded-xl hover:bg-slate-100 transition" do %>
                <span class="text-xl">📋</span>
                <span>案件一覧</span>
              <% end %>
            <% end %>
          </nav>

          <div class="p-4 border-t border-slate-200 bg-slate-50">
            <% if logged_in? %>
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">ログイン中</div>
              <div class="text-sm font-medium text-slate-700 truncate mb-3"><%= current_user.email %></div>
              <%= button_to logout_path, method: :delete, data: { turbo: false }, class: "w-full py-2.5 px-4 bg-white border border-slate-300 text-rose-600 font-bold text-sm rounded-lg hover:bg-rose-50 transition text-center shadow-sm cursor-pointer" do %>
                ログアウト
              <% end %>
            <% else %>
              <div class="space-y-2">
                <%= link_to login_path, data: { turbo: false }, class: "block w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-lg transition text-center shadow-sm" do %>
                  ログイン
                <% end %>
              </div>
            <% end %>
          </div>
        </aside>

        <!-- メインコンテンツ -->
        <main class="flex-1 flex flex-col min-w-0 bg-slate-100 text-slate-800">
          <div class="p-8 max-w-7xl mx-auto w-full">
            <%= yield %>
          </div>
        </main>
      </div>
    <% end %>

    <%= render 'shared/footer' %>
    
  </body>
</html>