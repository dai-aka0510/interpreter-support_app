<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-xl mx-auto bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h1 class="text-3xl font-bold text-slate-800 mb-6">お問い合わせ</h1>
    <p class="text-slate-600 mb-6">ご質問やご要望がございましたら、以下のフォームよりお気軽にお問い合わせください。</p>
    
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">お名前</label>
        <input type="text" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="例：山田 太郎">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">メールアドレス</label>
        <input type="email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="例：example@email.com">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">お問い合わせ内容</label>
        <textarea rows="4" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="お問い合わせ内容をご記入ください"></textarea>
      </div>
      <button type="button" class="w-full py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition">送信する</button>
    </div>

    <div class="mt-8">
      <%= link_to 'トップに戻る', root_path, class: 'text-indigo-600 hover:text-indigo-800 font-medium' %>
    </div>
  </div>
</div>