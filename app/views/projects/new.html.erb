<h1>案件新規作成</h1>

<%= form_with model: @project, local: true do |f| %>
  <div class="field">
    <%= f.label :title, "案件タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :description, "詳細・説明" %><br>
    <%= f.text_area :description %>
  </div>

  <div class="actions">
    <%= f.submit "作成する" %>
  </div>
<% end %>

<%= link_to "一覧に戻る", projects_path %>
