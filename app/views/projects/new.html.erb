<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-6 text-gray-800 text-center">新規案件登録</h1>

  <%= form_with model: @project, local: true, class: "space-y-4" do |f| %>
    <% if @project.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-md text-red-700 text-sm">
        <p class="font-bold mb-1"><%= @project.errors.count %>件のエラーがあります：</p>
        <ul class="list-disc list-inside space-y-1">
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "案件名", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :title, placeholder: "例：〇〇会議 同時通訳", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>

    <div>
      <%= f.label :client_name, "クライアント名", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :client_name, placeholder: "例：株式会社〇〇", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>

    <div>
      <%= f.label :amount, "金額（円）", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :amount, placeholder: "例：50000", class: "mt-1 box-border block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>

    <div>
      <%= f.label :event_date, "通訳実施日", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :event_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>

    <div class="pt-4">
      <%= f.submit "登録する", class: "w-full bg-indigo-600 text-white font-bold py-3 px-4 rounded-md hover:bg-indigo-700 transition duration-200 text-lg cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= link_to "案件一覧へ戻る", projects_path, class: "text-sm text-indigo-600 hover:underline" %>
  </div>
</div>