<div class="max-w-4xl mx-auto space-y-6">

  <!-- ページヘッダー＆戻るボタン -->
  <div class="flex items-center justify-between">
    <%= link_to projects_path, data: { turbo: false }, class: "inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 font-bold transition text-base" do %>
      <span>←</span>
      <span>案件一覧に戻る</span>
    <% end %>

    <!-- 編集・削除ボタンエリア -->
    <div class="flex items-center gap-3">
      <%= link_to edit_project_path(@project), data: { turbo: false }, class: "px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm rounded-xl shadow-sm transition active:scale-95" do %>
        ✏️ 編集する
      <% end %>

      <%= button_to project_path(@project), method: :delete, data: { turbo_confirm: "本当にこの案件を削除しますか？" }, class: "px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm rounded-xl shadow-sm transition active:scale-95 cursor-pointer" do %>
        🗑️ 削除する
      <% end %>
    </div>
  </div>

  <!-- 案件詳細カード -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8 space-y-8">
    <div class="border-b border-slate-200 pb-6">
      <div class="text-sm font-semibold text-blue-600 mb-1">通訳案件の詳細</div>
      <h1 class="text-3xl font-extrabold text-slate-900"><%= @project.title %></h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- クライアント名 -->
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-1">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">クライアント名</div>
        <div class="text-xl font-bold text-slate-900"><%= @project.client_name %></div>
      </div>

      <!-- 通訳実施日 -->
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-1">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">通訳実施日</div>
        <div class="text-xl font-bold text-slate-900">📅 <%= @project.event_date %></div>
      </div>

      <!-- 報酬金額 -->
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-1 md:col-span-2">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">報酬金額</div>
        <div class="text-3xl font-extrabold text-slate-900">
          <%= number_to_currency(@project.amount, unit: "￥", precision: 0) rescue "￥#{@project.amount}" %>
        </div>
      </div>
    </div>

    <!-- 領収証・経費明細セクション -->
    <div class="border-t border-slate-200 pt-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900">領収証・経費明細</h3>
          <p class="text-sm text-slate-500">この案件にかかった経費や領収証を管理します</p>
        </div>
        <%= link_to "＋ 領収証を登録する", new_project_receipt_path(@project), data: { turbo: false }, class: "px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-sm transition active:scale-95" %>
      </div>

      <!-- 登録された領収証の一覧表示 -->
      <% if @project.receipts.any? %>
        <div class="divide-y divide-slate-200 border border-slate-200 rounded-xl overflow-hidden mt-4">
          <% @project.receipts.each do |receipt| %>
            <div class="p-4 flex items-center justify-between bg-white hover:bg-slate-50 transition">
              <div class="space-y-1">
                <div class="font-bold text-slate-900"><%= receipt.title %></div>
                <div class="text-xs text-slate-500">
                  発行日: <%= receipt.issued_date %> | 勘定科目: <%= receipt.account_item.presence || "未設定" %>
                </div>
                <% if receipt.memo.present? %>
                  <div class="text-xs text-slate-600 bg-slate-100 p-2 rounded mt-1"><%= receipt.memo %></div>
                <% end %>
              </div>

              <!-- 金額と削除ボタンを並べるエリア -->
              <div class="flex items-center gap-6">
                <div class="text-right">
                  <div class="text-lg font-extrabold text-slate-900">￥<%= number_with_delimiter(receipt.amount) %></div>
                </div>

                <!-- 削除ボタン -->
                <%= button_to "削除", project_receipt_path(@project, receipt), method: :delete, data: { turbo_confirm: "本当にこの領収証を削除しますか？" }, class: "px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-lg transition cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 italic mt-2">まだ領収証が登録されていません。</p>
      <% end %>
    </div>
  </div>

</div>
