<div class="max-w-2xl mx-auto space-y-6">

  <!-- 戻るリンク -->
  <div>
    <%= link_to project_path(@project), data: { turbo: false }, class: "inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 font-bold transition text-base" do %>
      <span>←</span>
      <span>詳細画面に戻る</span>
    <% end %>
  </div>

  <!-- 編集フォーム用カード -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">通訳案件の編集</h1>
      <p class="text-sm text-slate-600 mt-1">案件の情報を更新して保存してください。</p>
    </div>

    <%= form_with model: @project, local: true, data: { turbo: false }, class: "space-y-5" do |f| %>
      
      <!-- エラーメッセージ表示（もしあれば） -->
      <% if @project.errors.any? %>
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-bold space-y-1">
          <div>入力内容にエラーがあります</div>
          <ul class="list-disc list-inside text-xs font-normal">
            <% @project.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :title, "案件名", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.text_field :title, class: "w-full px-4 py-3 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
      </div>

      <div>
        <%= f.label :client_name, "クライアント名", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.text_field :client_name, class: "w-full px-4 py-3 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
      </div>

      <div>
        <%= f.label :event_date, "通訳実施日", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.date_field :event_date, class: "w-full px-4 py-3 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
      </div>

      <div>
        <%= f.label :amount, "報酬金額 (円)", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.number_field :amount, class: "w-full px-4 py-3 border border-slate-300 rounded-xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
      </div>

      <div class="pt-4 flex items-center gap-4">
        <%= f.submit "変更を保存する", class: "flex-1 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-base rounded-xl shadow-md transition cursor-pointer active:scale-95 text-center" %>
        <%= link_to "キャンセル", project_path(@project), data: { turbo: false }, class: "py-3.5 px-6 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-base rounded-xl transition text-center" %>
      </div>

    <% end %>
  </div>

</div>