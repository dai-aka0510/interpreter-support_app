<div class="space-y-8">

  <!-- 1. ウェルカムヘッダー -->
  <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-8 text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight">
        おかえりなさい！👋
      </h1>
      <p class="text-blue-100 text-base">
        通訳案件のスケジュール確認や、新しい案件の登録をここからスムーズに行えます。
      </p>
    </div>
  </div>

  <!-- 2. 数字が一目でわかる概要カード（サマリー） -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- カード1：今月の案件数 -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-5">
      <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-2xl shrink-0">
        📅
      </div>
      <div>
        <div class="text-sm font-semibold text-slate-500">今月の予定案件</div>
        <div class="text-3xl font-extrabold text-slate-900 mt-1">
          <%= @projects_count || 1 %> <span class="text-base font-normal text-slate-500">件</span>
        </div>
      </div>
    </div>

    <!-- カード2：今月の予想報酬 -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-5">
      <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl shrink-0">
        💰
      </div>
      <div>
        <div class="text-sm font-semibold text-slate-500">今月の想定報酬</div>
        <div class="text-3xl font-extrabold text-slate-900 mt-1">
          ￥50,000
        </div>
      </div>
    </div>

    <!-- カード3：クライアント数 -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-5">
      <div class="w-14 h-14 bg-violet-100 text-violet-600 rounded-2xl flex items-center justify-center text-2xl shrink-0">
        🏢
      </div>
      <div>
        <div class="text-sm font-semibold text-slate-500">取引先クライアント</div>
        <div class="text-3xl font-extrabold text-slate-900 mt-1">
          1 <span class="text-base font-normal text-slate-500">社</span>
        </div>
      </div>
    </div>

  </div>

  <!-- 3. クイックアクション＆案内エリア -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- 左側：クイックナビゲーション -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <span>⚡</span> クイック操作
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= link_to projects_path, class: "p-4 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 transition block space-y-2 group" do %>
          <div class="text-2xl group-hover:scale-110 transition-transform">📋</div>
          <div class="font-bold text-slate-900">案件一覧を見る</div>
          <div class="text-xs text-slate-500">登録済みの案件や履歴を一覧で確認します</div>
        <% end %>

        <%= link_to new_project_path, class: "p-4 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 transition block space-y-2 group" do %>
          <div class="text-2xl group-hover:scale-110 transition-transform">✍️</div>
          <div class="font-bold text-slate-900">新しい案件を追加</div>
          <div class="text-xs text-slate-500">受託した新しい通訳案件を入力します</div>
        <% end %>
      </div>
    </div>

    <!-- 右側：お知らせ・ヒント -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <span>💡</span> 通訳準備のヒント
      </h2>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
        <div class="font-bold text-sm text-slate-800">事前準備・用語集の作成</div>
        <p class="text-xs text-slate-600 leading-relaxed">
          通訳案件の前に用語集を作成しておくと、当日のパフォーマンスが向上します。案件ごとにメモを残しておきましょう。
        </p>
      </div>
    </div>

  </div>

</div>